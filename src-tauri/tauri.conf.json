{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tau Omega",
  "version": "0.4.0",
  "identifier": "dev.tau.omega",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../ui"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../ui"
    },
    "devUrl": "http://localhost:5173",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tau Omega",
        "width": 1120,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "msi",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "alfatreze",
    "category": "Music",
    "shortDescription": "Library and card manager for the Tau music core on the Analogue Pocket",
    "longDescription": "Tau Omega manages the music, themes, Halcyon EQ presets and Tau cores on an Analogue Pocket SD card: it builds and verifies the library index, syncs music, installs and updates Tau, and reads the Pocket's diagnostic reports.",
    "copyright": "alfatreze",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4M0MxMTY0QTg1NDFCNTIKUldSU0cxU29aQkU4cUl0aVBhbHRRWTdjdXMxY3BwdmU4Q3JzVEw1di90K2N0SGpMWG1VdWYrV0oK",
      "endpoints": [
        "https://github.com/alfatreze/Tau-Omega/releases/latest/download/latest.json"
      ]
    }
  }
}
